# Server-only; never prefix the Supabase service key with VITE_.
SUPABASE_URL=https://evjmldyntpadgcqxxlzp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
GROQ_API_KEY=

# Configure both keys to enable push, or leave both blank.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Maps: this VITE_ key is exposed in the browser bundle; use a restricted public key.
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.ai
VITE_FRONTEND_FORGE_API_KEY=

# Retell website widget: browser-safe public key; restrict it to agentsplus.online and www.agentsplus.online.
VITE_RETELL_VOICE_PUBLIC_KEY=
# Optional: only set this if Retell Support issued an official white-label token.
VITE_RETELL_WHITE_LABEL_TOKEN=
# Server-only Retell API key with webhook verification support; never use a VITE_ prefix.
RETELL_API_KEY=
# Optional analytics; only loaded when both are set.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional integration-test target; leave blank to skip live endpoint tests.
TEST_BASE_URL=
